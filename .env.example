# Copy this file to .env and fill in your own values. .env is gitignored.
# These are read by both the bot and the web control panel at startup.

# Chronogolf login, so the bot can sign itself in for each run (the saved
# browser session does not survive a restart, so the bot logs in each time):
CHRONO_USER=you@example.com
CHRONO_PASS=your-chronogolf-password

# Gmail account that sends the confirmation email:
SKYWAY_SMTP_USER=you@gmail.com

# Gmail App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords). A normal account password will not work with SMTP.
SKYWAY_SMTP_PASS=your-16-char-app-password

# Where booking confirmations are sent:
SKYWAY_NOTIFY_EMAIL=you@example.com

# Optional SMTP overrides (defaults shown):
# SKYWAY_SMTP_HOST=smtp.gmail.com
# SKYWAY_SMTP_PORT=587
